{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMP Control Room",
  "version": "1.0.0",
  "identifier": "dev.omp.control-room",
  "build": {
    "beforeBuildCommand": "node scripts/stage-runtime.mjs"
  },
  "app": { "windows": [] },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/bun"],
    "resources": {
      "../companion/": "companion/",
      "../local-dist/": "local-dist/",
      "../desktop/host.mjs": "desktop/host.mjs",
      "../desktop/links.mjs": "desktop/links.mjs",
      "../desktop/shell-env.mjs": "desktop/shell-env.mjs"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-", "entitlements": "Entitlements.plist" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENDYzQTE2MUU0NUU3OUIKUldTYjUwVWVGanBHbldVNUpmcGFGd3hBR3dPZFhwQTlqN012dmZyWWtndXFwYVNnYWV2cHJseG4K",
      "endpoints": ["https://github.com/ataberkus/omp-companion/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
