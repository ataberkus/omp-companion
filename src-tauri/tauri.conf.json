{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMP Control Room",
  "version": "1.0.0",
  "identifier": "dev.omp.control-room",
  "build": {},
  "app": { "windows": [] },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "../companion/": "companion/",
      "../local-dist/": "local-dist/",
      "../desktop/host.mjs": "desktop/host.mjs",
      "../desktop/links.mjs": "desktop/links.mjs"
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
